class Solution {
    static long kthDigit(int a, int b, int k) {
        // code here
        int i=1;
        long power=(long)Math.pow(a,b);
        while(power>0)
        {
            long n=power%10;
            if(k==i)
            {
                return n;
            }
            power=power/10;
            i++;
        }
        return 0;
    }
}
