import java.util.Arrays;
class Solution {
    int majorityElement(int arr[]) {
        if (arr.length == 1) return arr[0];
        
        Arrays.sort(arr);
        int count = 1; 
        for (int i = 0; i < arr.length - 1; i++) {
            if (arr[i] == arr[i+1]) {
                count += 1;
            } else {
                count = 1; 
            }
            
            if (count > arr.length / 2) {
                return arr[i];
            }
        }
        return -1;
    }
}
