class Solution {
    int lcmTriplets(int n) {
        if(n<=2)
         return n;
        int m=0;
        if(n%2!=0)
        {
            m=n*(n-1)*(n-2);
        }
        else
        {
          if(n%3!=0)
            m=n*(n-1)*(n-3);
          else 
            m=(n-1)*(n-2)*(n-3);
        }
        return m;
            
    }
}
