import java.util.*;

class GFG {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int m = sc.nextInt();

        System.out.println(compareNM(n, m));  
    }

    static String compareNM(int n, int m) {
        if (n < m) {
            return "less";
        } else if (n == m) {
            return "equal";
        } else {
            return "greater";
        }
    }
}
